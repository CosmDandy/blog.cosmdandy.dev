// Пребилт-образ из CosmDandy/dotfiles: плагины nvim, mason-пакеты и
// treesitter-парсеры уже внутри, поэтому нет onCreateCommand и setup.sh.
// Профили: :core — редактор и шелл, :devops — плюс terraform/k8s/ansible.
// containerEnv, а не remoteEnv: локаль нужна и демонам, и docker exec.
{
  "name": "blog.cosmdandy.dev DevContainer",
  "image": "ghcr.io/cosmdandy/devcontainer:core",
  "initializeCommand": "docker pull ghcr.io/cosmdandy/devcontainer:core || true",
  // 8080 — дев-сервер quartz build --serve, 3001 — его сокет hot-reload.
  "forwardPorts": [8080, 3001],
  "postCreateCommand": "npm ci",
  "containerEnv": {
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "TZ": "Europe/Moscow"
  },
  "remoteEnv": {
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  }
}
