# Кэширование статики. Cloudflare Workers по умолчанию отдаёт всё с
# max-age=0, must-revalidate — то есть каждый повторный визит стучится за
# каждым файлом, даже если тот не менялся. Здесь это снимается для файлов, у
# которых имя содержит хэш содержимого: поменялось содержимое — поменялось имя,
# поэтому устаревшего ответа из кэша быть не может по построению.
#
# Файлы без хэша в имени (HTML, og-картинки) намеренно не
# упомянуты и остаются на ревалидации по ETag.
#
# Правила комбинируются аддитивно: если запрос подходит под два блока, значения
# одноимённых заголовков склеиваются через запятую. Поэтому паттерны ниже не
# должны пересекаться между собой.
#
# Файл лежит в content/, откуда Quartz копирует его в корень сайта — там же,
# где robots.txt.

/index-*.css
  Cache-Control: public, max-age=31536000, immutable

/component-*.css
  Cache-Control: public, max-age=31536000, immutable

/prescript-*.js
  Cache-Control: public, max-age=31536000, immutable

/postscript-*.js
  Cache-Control: public, max-age=31536000, immutable

/static/resource-style-*.css
  Cache-Control: public, max-age=31536000, immutable

/static/resource-after-*.js
  Cache-Control: public, max-age=31536000, immutable

# Имена шрифтов — хэши от Google Fonts, содержимое за ними неизменно.
/static/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
